{
  "schema": 2,
  "id": "com.example.my-plugin",
  "name": "Örnek Eklenti",
  "version": "0.1.0",
  "description": "Makine eklenti şablonu: bir eylem, ayarlar ve durum satırı.",
  "publisher": "Adınız",
  "license": "AGPL-3.0-only WITH Commons-Clause",
  "homepage": "https://github.com/kullanici-adiniz/my-plugin",
  "abi": 2,
  "minLauncher": "0.2.0",
  "entry": "bin/my-plugin.dll",
  "capabilities": [],
  "contributes": {
    "settings": [
      { "key": "greeting", "type": "text", "label": "Selam metni",
        "description": "\"Selam ver\" bildiriminde görünür.", "default": "Merhaba!" },
      { "key": "showUptime", "type": "toggle", "label": "Çalışma süresini göster",
        "description": "Durum satırında eklentinin ne kadar süredir çalıştığını gösterir.", "default": true },
      { "key": "interval", "type": "number", "label": "Durum yenileme aralığı (saniye)",
        "min": 5, "max": 3600, "default": 60 }
    ],
    "actions": [
      { "id": "hello", "label": "Selam ver", "description": "Bir bildirim gösterir ve hello.log'a yazar." }
    ],
    "events": [ "settings.changed" ]
  }
}
